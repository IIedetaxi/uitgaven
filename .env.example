# Postgres-verbinding (wordt automatisch gezet door de Neon-integratie op Vercel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Je pincode om in te loggen (gebruik bij voorkeur 6+ cijfers)
APP_PIN=123456

# Lange willekeurige string om de login-cookie te ondertekenen
# Genereer met: openssl rand -hex 32
AUTH_SECRET=vervang-mij-door-een-lange-random-string
